# Project Configuration
PROJECT_NAME="Automated IT Ticket Classification System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True

# Security
SECRET_KEY="replace_with_a_secure_random_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# PostgreSQL: postgresql://postgres:postgres@localhost:5432/it_helpdesk
# SQLite: sqlite:///./helpdesk.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/it_helpdesk"

# ML Artifacts & Thresholds
MODEL_DIR="app/ml/artifacts"
CONFIDENCE_THRESHOLD=0.80

# Upload Directory
UPLOAD_DIR="data/uploads"
MAX_UPLOAD_SIZE_MB=10

# SLA Configuration (Resolution hours by priority)
SLA_CRITICAL_HOURS=2
SLA_HIGH_HOURS=4
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=72
